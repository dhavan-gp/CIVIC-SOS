{
  "name": "ict",
  "version": "1.0.0",
  "description": "Civic & Emergency Response Platform - Dual Portal Architecture & Android Mobile App",
  "main": "index.js",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "citizen": "npm run dev --prefix citizen-portal",
    "admin": "npm run dev --prefix admin-portal",
    "dev:citizen": "npm run dev --prefix citizen-portal",
    "dev:admin": "npm run dev --prefix admin-portal",
    "dev:server": "npm run server",
    "dev": "concurrently -n \"SERVER,CITIZEN,ADMIN\" -c \"blue,cyan,magenta\" \"npm run server\" \"npm run citizen\" \"npm run admin\"",
    "build:citizen": "npm run build --prefix citizen-portal",
    "build:admin": "npm run build --prefix admin-portal",
    "build": "npm run build:citizen && npm run build:admin",
    "android:sync": "npm run android:sync --prefix citizen-portal",
    "android:open": "npm run android:open --prefix citizen-portal",
    "build:apk": "npm run android:sync && cd citizen-portal/android && .\\gradlew.bat assembleDebug",
    "test": "npx tsx server/src/test_e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
